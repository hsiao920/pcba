(version 1)

(rule "DiffPair_D1_gap"
  (condition "A.NetName == 'OTG_DP' && B.NetName == 'OTG_DM'")
  # PADS pair gap 0.1524mm is a routing target; DRC uses the source 4 mil clearance
  (constraint clearance (min 0.1016mm)))

(rule "DiffPair_D2_gap"
  (condition "A.NetName == 'MIPI_DSI_TX0_D0N' && B.NetName == 'MIPI_DSI_TX0_D0P'")
  # PADS pair gap 0.15748mm is a routing target; DRC uses the source 4 mil clearance
  (constraint clearance (min 0.1016mm)))

(rule "DiffPair_D3_gap"
